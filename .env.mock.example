# Local demo with the fake Elasticsearch / Kibana / LLM from `npm run mock`.
# cp .env.mock.example .env   then   npm run mock   and (in another terminal)   npm run dev
ELASTIC_URL=http://localhost:9200
ELASTIC_API_KEY=mock
LOG_INDEX_PATTERNS=logs-*
KIBANA_URL=http://localhost:5601
LLM_BASE_URL=http://localhost:4010/v1
LLM_API_KEY=mock
LLM_MODEL=mock-model
PORT=8787
# Admin panel for the demo (#/admin)
ADMIN_PASSWORD=admin
