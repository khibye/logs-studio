    "properties": {
      "dashboard_id": { "type": "keyword" },
      "version": { "type": "integer" },
      "title": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },
      "notes": { "type": "text" },
      "saved_at": { "type": "date" },
      "panel_count": { "type": "integer" },
      "forked_from_id": { "type": "keyword" },
      "forked_from_version": { "type": "integer" },
      "recipe_json": { "type": "text", "index": false }
    }
  }
}
