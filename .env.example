# Every setting below (except PORT, ADMIN_PASSWORD, DATA_DIR, LOG_CONTEXT_FILE) can also be
# changed at runtime from the admin panel; values set there override these.

# ---------- Elasticsearch ----------
# How to reach Elasticsearch: auto (default) | direct | kibana
#   kibana = through Kibana's console proxy, when you only have the Kibana address.
#            The API key then also needs the Dev Tools privilege in Kibana.
#   auto   = direct if ELASTIC_URL is set, otherwise through Kibana.
# ELASTIC_CONNECTION=auto
# Leave empty if you only have Kibana. (Kibana → Help menu → Connection details shows the endpoint.)
ELASTIC_URL=https://my-deployment.es.example.com:9243
# Base64 "encoded" API key (the value Kibana shows as "Encoded")
ELASTIC_API_KEY=
# Index patterns the model and dashboards may query (comma separated)
LOG_INDEX_PATTERNS=logs-*
TIME_FIELD=@timestamp
# What the data means, in your words. Given to the model in every conversation.
# Use \n for new lines, or put a longer text in a file and point LOG_CONTEXT_FILE at it.
# LOG_CONTEXT="service.name = שם השירות\nhttp.response.status_code = קוד התשובה\nשגיאות: log.level == \"error\""
# LOG_CONTEXT_FILE=./log-context.md
# Shared dashboards library. Needs read + create_doc on this index; without them the app falls back to links / JSON files.
DASHBOARDS_INDEX=ai-dashboards
MAX_ROWS=1000
QUERY_TIMEOUT_MS=30000

# ---------- Kibana (optional) ----------
# Used for "Open in Discover" links, and for export to Kibana dashboards on 9.4+
KIBANA_URL=https://my-deployment.kb.example.com:9243
# If browsers reach Kibana at a different address than the server does:
# KIBANA_PUBLIC_URL=
# KIBANA_SPACE=ai-reports
# KIBANA_API_KEY=          # defaults to ELASTIC_API_KEY
# KIBANA_EXPORT=off        # "auto" (default): on only when Kibana is 9.4+

# ---------- LLM (any OpenAI-compatible /v1/chat/completions with tool calling) ----------
LLM_BASE_URL=https://my-llm.example.com/v1
LLM_API_KEY=
# Default model
LLM_MODEL=
# Models offered in the chat's model picker (comma separated).
# Empty = every chat model the key lists at <LLM_BASE_URL>/models.
# LLM_MODELS=
# Set to false if your server has trouble streaming tool calls
LLM_STREAM=true
LLM_MAX_STEPS=14
LLM_TEMPERATURE=0.2

# ---------- App ----------
PORT=8787
# Enables the admin panel (#/admin). Environment only.
# ADMIN_PASSWORD=
# Where admin-panel settings are saved (settings.json). Mount a persistent volume here.
# DATA_DIR=./data
# Conversations are kept in the user's own browser (never on the server) for this many hours. 0 = not kept.
CHAT_RETENTION_HOURS=24
# Protect the whole app with HTTP basic auth ("user:password"). Recommended when deployed.
# APP_BASIC_AUTH=
